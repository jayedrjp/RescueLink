# RescueLink Firebase Web Configuration
# Retrieve these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app (SDK setup and configuration)

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Optional: Firebase App Check (reCAPTCHA v3 site key)
# Register your web app in Firebase Console -> App Check -> Apps -> Register with reCAPTCHA v3.
# When omitted, App Check is safely disabled (default for local development and CI).
VITE_FIREBASE_APPCHECK_KEY=

# Optional: Web Push / VAPID Public Key for Background Weather Push Notifications
# Generated using `npx web-push generate-vapid-keys`.
# When omitted, browser in-app weather notifications and toasts remain 100% active.
VITE_VAPID_PUBLIC_KEY=

# Optional: Google OAuth Web Client ID for Android/iOS native sign-in via Capacitor.
# Found in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client.
VITE_GOOGLE_WEB_CLIENT_ID=

# Optional: lets the sign-in form accept the username "admin" for this account.
# There is NO default. It grants no privileges by itself: the admin role is read from Firestore
# (users/{uid}.role == "admin"), and this email cannot be used to register through the public sign-up form.
# Create this Authentication user yourself in Firebase Console -> Authentication -> Users -> Add user.
VITE_ADMIN_EMAIL=
