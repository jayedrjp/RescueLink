# =============================================================================
# RescueLink Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Replace the placeholder values with your real Firebase web app credentials.
# 3. NOTICE: All VITE_* variables are embedded into client JavaScript bundles at
#    build time. Never place private server keys, service account JSON, or database
#    secrets in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED FIREBASE CLIENT CONFIGURATION
#
# Obtain these values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# -----------------------------------------------------------------------------
# 2. OPTIONAL FIREBASE WEB APP FIELDS
#
# Standard Firebase web configuration fields:
# - Storage bucket & messaging sender ID are present in the standard web config snippet.
# - Measurement ID is used for Google Analytics 4 (when enabled in Firebase Console).
# -----------------------------------------------------------------------------
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# -----------------------------------------------------------------------------
# 3. OPTIONAL INTEGRATIONS & SECURITY FEATURES
# -----------------------------------------------------------------------------

# Optional: Firebase App Check (reCAPTCHA v3 site key)
# Register your web app in Firebase Console -> App Check -> Apps -> Register with reCAPTCHA v3.
# When omitted or empty, App Check is safely disabled (default for local development and CI).
VITE_FIREBASE_APPCHECK_KEY=

# Optional: Web Push / VAPID Public Key for Background Weather Push Notifications
# Generate a pair using: npx web-push generate-vapid-keys
# When omitted, browser in-app weather notifications, alerts, and banners remain 100% active.
VITE_VAPID_PUBLIC_KEY=

# Optional: Google OAuth Web Client ID for Android/iOS native sign-in via Capacitor.
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client.
VITE_GOOGLE_WEB_CLIENT_ID=

# Optional: Administrator Sign-In Shortcut Email
# When set, typing "admin" as the username on the login screen automatically maps to this email.
# Security Note: This grants NO privileges by itself. The admin role is read strictly from Cloud
# Firestore (users/{uid}.role == "admin"). Create the admin user in Firebase Console -> Authentication.
VITE_ADMIN_EMAIL=admin@rescuelink.org
